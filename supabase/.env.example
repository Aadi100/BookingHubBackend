# Supabase Environment Variables
# Copy to .env.local and fill in actual values

# ============================================================================
# SUPABASE CONNECTION
# ============================================================================
# From Supabase Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# PAYMENT GATEWAYS
# ============================================================================
# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# JazzCash
JAZZCASH_MERCHANT_ID=TESTMER000001
JAZZCASH_PASSWORD=testpassword
JAZZCASH_INTEGRITY_SALT=testsalt

# EasyPaisa
EASYPAISA_STORE_ID=test_store
EASYPAISA_MERCHANT_ID=test_merchant
EASYPAISA_HASH_KEY=test_key

# PayFast (PK)
PAYFAST_MERCHANT_ID=10000100
PAYFAST_SECURED_KEY=testsecuredkey

# ============================================================================
# EMAIL (Resend)
# ============================================================================
RESEND_API_KEY=re_...
RESEND_FROM_ADDRESS=Booking Hub <noreply@yourdomain.com>
RESEND_REPLY_TO=support@yourdomain.com

# ============================================================================
# WHATSAPP (Meta Cloud API)
# ============================================================================
WHATSAPP_PHONE_NUMBER_ID=1234567890
WHATSAPP_ACCESS_TOKEN=EAAG...
WHATSAPP_BUSINESS_ACCOUNT_ID=9876543210
WHATSAPP_API_VERSION=v21.0

# ============================================================================
# TAX (FBR - Pakistan)
# ============================================================================
# Only needed if any branch has tax_enabled = true
FBR_BASE_URL=https://sandbox.fbr.gov.pk  # or production URL
FBR_CLIENT_ID=your_client_id
FBR_CLIENT_SECRET=your_client_secret

# ============================================================================
# LOCAL DEVELOPMENT
# ============================================================================
# Use these for local Supabase development
SUPABASE_DB_PASSWORD=postgres
SUPABASE_ADMIN_PASSWORD=postgres
